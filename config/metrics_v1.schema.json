{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orfadc:metrics:v1",
  "title": "Open-RFAmpDesigner-Cadence metrics envelope v1",
  "type": "object",
  "required": [
    "schema_version", "status", "simulation_status", "circuit_class",
    "not_lna_result", "spec_pass", "run_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"type": "string", "minLength": 1},
    "simulation_status": {"enum": ["ok", "failed", "unknown"]},
    "source": {"type": "string", "minLength": 1},
    "circuit_class": {"type": "string", "minLength": 1},
    "not_lna_result": {"type": "boolean"},
    "spec_pass": {"type": ["boolean", "null"]},
    "run_id": {"type": "string", "minLength": 1},
    "spec": {"type": ["object", "null"]},
    "candidate": {"type": ["object", "null"]},
    "seed": {"type": ["integer", "null"], "minimum": 0},
    "timeout_seconds": {"type": ["integer", "null"], "exclusiveMinimum": 0},
    "analysis": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "units": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "violation": {"type": ["object", "null"]},
    "reference_planes": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "output": {"type": "string", "minLength": 1},
        "z0_ohm": {"type": "number", "exclusiveMinimum": 0},
        "input_z0_ohm": {"type": "number", "exclusiveMinimum": 0},
        "output_z0_ohm": {"type": "number", "exclusiveMinimum": 0}
      },
      "oneOf": [
        {"required": ["z0_ohm"], "not": {"anyOf": [{"required": ["input_z0_ohm"]}, {"required": ["output_z0_ohm"]}]}},
        {"required": ["input_z0_ohm", "output_z0_ohm"], "not": {"required": ["z0_ohm"]}}
      ],
      "additionalProperties": false
    },
    "port_reference_ohm": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": {"type": "number", "exclusiveMinimum": 0},
        "output": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "frequency_band_ghz": {
      "type": "object",
      "required": ["low", "high"],
      "properties": {"low": {"type": "number", "exclusiveMinimum": 0}, "high": {"type": "number"}},
      "additionalProperties": false
    },
    "metrics": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"candidate": {"type": "object"}}, "required": ["candidate"]},
      "then": {
        "required": ["spec", "seed", "timeout_seconds"],
        "properties": {
          "spec": {"type": "object", "required": ["id"]},
          "seed": {"type": "integer", "minimum": 0},
          "timeout_seconds": {"type": "integer", "exclusiveMinimum": 0}
        }
      }
    },
    {
      "if": {"properties": {"spec": {"type": "object"}}, "required": ["spec"]},
      "then": {"required": ["candidate"], "properties": {"candidate": {"type": "object"}}}
    },
    {
      "if": {"properties": {"simulation_status": {"const": "ok"}}, "required": ["simulation_status"]},
      "then": {"required": ["source"]}
    },
    {
      "if": {"properties": {"not_lna_result": {"const": true}}, "required": ["not_lna_result"]},
      "then": {"properties": {"spec_pass": {"type": "null"}}}
    },
    {
      "if": {"properties": {"spec_pass": {"const": true}}, "required": ["spec_pass"]},
      "then": {
        "properties": {
          "circuit_class": {"const": "active_lna"},
          "not_lna_result": {"const": false},
          "simulation_status": {"const": "ok"},
          "source": {"const": "cadence_spectre"},
          "analysis": {"type": "array", "minItems": 4, "items": {"type": "string"}},
          "metrics": {"type": "object", "minProperties": 5},
          "spec": {"type": "object", "minProperties": 4},
          "units": {"type": "object"},
          "reference_planes": {
            "type": "object",
            "required": ["input", "output"]
          }
        },
        "required": ["source", "analysis", "metrics", "spec", "candidate", "seed", "timeout_seconds", "units", "reference_planes", "frequency_band_ghz"]
      }
    }
  ],
  "additionalProperties": true
}
