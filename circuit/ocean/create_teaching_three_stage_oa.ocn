orfThreeAdd(cv gndMaster 3 10 indMaster "L3P" list(list("l" "1n")) list(list("PLUS" "d3p") list("MINUS" "d3n")))
orfThreeAdd(cv gndMaster 3 11 capMaster "C3P" list(list("c" "250f")) list(list("PLUS" "d3p") list("MINUS" "d3n")))
orfThreeAdd(cv gndMaster 3 12 indMaster "L3S" list(list("l" "1n")) list(list("PLUS" "outp") list("MINUS" "outn")))
orfThreeAdd(cv gndMaster 3 13 mindMaster "K3" list(list("ind1" "L3P") list("ind2" "L3S") list("k" "0.45")) nil)
orfThreeAdd(cv gndMaster 3 14 portMaster "PORT2" list(list("num" "2") list("r" "1787")) list(list("PLUS" "outp") list("MINUS" "outn")))
orfThreeAdd(cv gndMaster 3 15 capMaster "CL" list(list("c" "62f")) list(list("PLUS" "outp") list("MINUS" "outn")))

checkResult=schCheck(cv)
fprintf(reportPort "check_return=%L\n" checkResult)
saveResult=dbSave(cv)
fprintf(reportPort "save_return=%L instances=%d nets=%d\n"
  saveResult length(cv~>instances) length(cv~>nets))
foreach(netId cv~>nets
  fprintf(reportPort "net=%s instterms=%d\n" netId~>name length(netId~>instTerms))
)
dbClose(cv)
foreach(master list(mosMaster portMaster vdcMaster resMaster capMaster indMaster mindMaster gndMaster)
  dbClose(master)
)
close(reportPort)
exit()
