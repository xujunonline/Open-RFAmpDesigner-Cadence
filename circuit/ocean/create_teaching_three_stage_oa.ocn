orfThreeAdd(cv gndMaster 1 8 resMaster "R12P" list(list("r" "150")) list(list("PLUS" "vdd") list("MINUS" "d1")))
orfThreeAdd(cv gndMaster 1 9 capMaster "C12P" list(list("c" "225.079079039277f")) list(list("PLUS" "vdd") list("MINUS" "d1")))
orfThreeAdd(cv gndMaster 1 10 indMaster "L12S" list(list("l" "1n")) list(list("PLUS" "g2p") list("MINUS" "g2n")))
orfThreeAdd(cv gndMaster 1 11 mindMaster "K12" list(list("ind1" "L12P") list("ind2" "L12S") list("k" "0.45")) nil)

orfThreeAdd(cv gndMaster 2 0 resMaster "RB2P" list(list("r" "100k")) list(list("PLUS" "g2p") list("MINUS" "vb2")))
orfThreeAdd(cv gndMaster 2 1 resMaster "RB2N" list(list("r" "100k")) list(list("PLUS" "g2n") list("MINUS" "vb2")))
orfThreeAdd(cv gndMaster 2 2 mosMaster "M3" list(list("model" "n_teach") list("w" "200u") list("l" "100n")) list(list("D" "d2p") list("G" "g2p") list("S" "s2p") list("B" "0")))
orfThreeAdd(cv gndMaster 2 3 mosMaster "M4" list(list("model" "n_teach") list("w" "200u") list("l" "100n")) list(list("D" "d2n") list("G" "g2n") list("S" "s2n") list("B" "0")))
orfThreeAdd(cv gndMaster 2 4 resMaster "RS2P" list(list("r" "10")) list(list("PLUS" "s2p") list("MINUS" "0")))
orfThreeAdd(cv gndMaster 2 5 resMaster "RS2N" list(list("r" "10")) list(list("PLUS" "s2n") list("MINUS" "0")))
orfThreeAdd(cv gndMaster 2 6 resMaster "RD2P" list(list("r" "150")) list(list("PLUS" "vdd") list("MINUS" "d2p")))
orfThreeAdd(cv gndMaster 2 7 resMaster "RD2N" list(list("r" "150")) list(list("PLUS" "vdd") list("MINUS" "d2n")))
orfThreeAdd(cv gndMaster 2 8 capMaster "CN2P" list(list("c" "10f")) list(list("PLUS" "d2p") list("MINUS" "g2n")))
orfThreeAdd(cv gndMaster 2 9 capMaster "CN2N" list(list("c" "10f")) list(list("PLUS" "d2n") list("MINUS" "g2p")))
orfThreeAdd(cv gndMaster 2 10 indMaster "L23P" list(list("l" "1n")) list(list("PLUS" "d2p") list("MINUS" "d2n")))
orfThreeAdd(cv gndMaster 2 11 capMaster "C23P" list(list("c" "250f")) list(list("PLUS" "d2p") list("MINUS" "d2n")))
orfThreeAdd(cv gndMaster 2 12 indMaster "L23S" list(list("l" "1n")) list(list("PLUS" "g3p") list("MINUS" "g3n")))
orfThreeAdd(cv gndMaster 2 13 mindMaster "K23" list(list("ind1" "L23P") list("ind2" "L23S") list("k" "0.45")) nil)

orfThreeAdd(cv gndMaster 3 0 resMaster "RB3P" list(list("r" "100k")) list(list("PLUS" "g3p") list("MINUS" "vb3")))
orfThreeAdd(cv gndMaster 3 1 resMaster "RB3N" list(list("r" "100k")) list(list("PLUS" "g3n") list("MINUS" "vb3")))
orfThreeAdd(cv gndMaster 3 2 mosMaster "M5" list(list("model" "n_teach") list("w" "200u") list("l" "100n")) list(list("D" "d3p") list("G" "g3p") list("S" "s3p") list("B" "0")))
orfThreeAdd(cv gndMaster 3 3 mosMaster "M6" list(list("model" "n_teach") list("w" "200u") list("l" "100n")) list(list("D" "d3n") list("G" "g3n") list("S" "s3n") list("B" "0")))
orfThreeAdd(cv gndMaster 3 4 resMaster "RS3P" list(list("r" "10")) list(list("PLUS" "s3p") list("MINUS" "0")))
orfThreeAdd(cv gndMaster 3 5 resMaster "RS3N" list(list("r" "10")) list(list("PLUS" "s3n") list("MINUS" "0")))
orfThreeAdd(cv gndMaster 3 6 resMaster "RD3P" list(list("r" "150")) list(list("PLUS" "vdd") list("MINUS" "d3p")))
orfThreeAdd(cv gndMaster 3 7 resMaster "RD3N" list(list("r" "150")) list(list("PLUS" "vdd") list("MINUS" "d3n")))
orfThreeAdd(cv gndMaster 3 8 capMaster "CN3P" list(list("c" "10f")) list(list("PLUS" "d3p") list("MINUS" "g3n")))
