reportPort=outfile("create_teaching_three_stage_report.txt" "w")
contextPath=getShellEnvVar("ORFADC_SCHEMATIC_CONTEXT")
unless(contextPath && isFile(contextPath) error("Schematic context file is required\n"))
loadContext(contextPath)
libName="orfadc_teaching_mos1"
libPath=getShellEnvVar("ORFADC_TEACHING_LIB_DIR")
cellName=getShellEnvVar("ORFADC_TEACHING_CELL")
unless(libPath && cellName error("Teaching library directory and cell name are required\n"))
libObj=ddGetObj(libName)
unless(libObj libObj=ddCreateLib(libName libPath))
unless(libObj error("Teaching design library unavailable\n"))
oldCv=dbOpenCellViewByType(libName cellName "schematic" "" "r")
when(oldCv
  dbClose(oldCv)
  error("Teaching cell already exists; refusing overwrite\n")
)
cv=dbOpenCellViewByType(libName cellName "schematic" "schematic" "w")
unless(cv error("Teaching three-stage schematic creation failed\n"))

mosMaster=dbOpenCellViewByType("analogLib" "nmos4" "symbol" "" "r")
portMaster=dbOpenCellViewByType("analogLib" "port" "symbol" "" "r")
vdcMaster=dbOpenCellViewByType("analogLib" "vdc" "symbol" "" "r")
resMaster=dbOpenCellViewByType("analogLib" "res" "symbol" "" "r")
capMaster=dbOpenCellViewByType("analogLib" "cap" "symbol" "" "r")
indMaster=dbOpenCellViewByType("analogLib" "ind" "symbol" "" "r")
mindMaster=dbOpenCellViewByType("analogLib" "mind" "symbol" "" "r")
gndMaster=dbOpenCellViewByType("analogLib" "gnd" "symbol" "" "r")
unless(mosMaster && portMaster && vdcMaster && resMaster && capMaster && indMaster && mindMaster && gndMaster
  error("Required analogLib symbol unavailable\n")
)

procedure(orfThreeAdd(cv gndMaster stage idx master name props connections)
  let((col row x y inst term pinCenter instCenter dx dy x2 y2 endpoint wireId ground)
    col=idx
    row=0
    while(col>=5
      col=col-5
      row=row+1
    )
    x=stage*25+col*4
    y=16-row*4
    inst=dbCreateInst(cv master name x:y "R0")
    unless(inst error("Three-stage instance creation failed\n"))
    foreach(prop props
      dbCreateProp(inst car(prop) "string" cadr(prop))
    )
    foreach(connection connections
      term=dbFindTermByName(master car(connection))
      unless(term && term~>pins error("Three-stage master terminal missing\n"))
      pinCenter=dbTransformPoint(centerBox(car(term~>pins)~>fig~>bBox) inst~>transform)
      instCenter=centerBox(inst~>bBox)
      dx=xCoord(pinCenter)-xCoord(instCenter)
      dy=yCoord(pinCenter)-yCoord(instCenter)
      if(abs(dx)>abs(dy) then
        x2=if(dx>=0 then xCoord(pinCenter)+0.75 else xCoord(pinCenter)-0.75)
        y2=yCoord(pinCenter)
      else
        x2=xCoord(pinCenter)
        y2=if(dy>=0 then yCoord(pinCenter)+0.75 else yCoord(pinCenter)-0.75)
      )
      endpoint=x2:y2
      wireId=schCreateWire(cv "draw" "full" list(pinCenter endpoint) 0.0625 0.0625 0.0)
      unless(wireId error("Three-stage terminal wire failed\n"))
      if(cadr(connection)=="0" then
        ground=dbCreateInst(cv gndMaster strcat("GND_" name "_" car(connection)) endpoint "R0")
        unless(ground error("Three-stage ground placement failed\n"))
      else
        schCreateWireLabel(cv car(wireId) endpoint cadr(connection) "lowerLeft" "R0" "stick" 0.0625 nil)
      )
    )
    inst
  )
)

orfThreeAdd(cv gndMaster 0 0 vdcMaster "VDD_SRC" list(list("vdc" "1.2")) list(list("PLUS" "vdd") list("MINUS" "0")))
orfThreeAdd(cv gndMaster 0 1 vdcMaster "VB1_SRC" list(list("vdc" "0.65")) list(list("PLUS" "vb1") list("MINUS" "0")))
orfThreeAdd(cv gndMaster 0 2 vdcMaster "VCAS_SRC" list(list("vdc" "1.05")) list(list("PLUS" "vcas") list("MINUS" "0")))
